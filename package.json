{
  "name": "rustarena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Learn Rust from zero to job-ready: lessons with real compilation, Deathmatch drills, projects and a Pro Track on your own machine.",
  "scripts": {
    "dev": "vite",
    "content": "node scripts/build-content.mjs",
    "runner": "node scripts/local-runner.mjs",
    "build": "tsc --noEmit && vite build && node scripts/pack-pro.mjs && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test:e2e": "node scripts/e2e.mjs",
    "check:pro": "bash pro-track/check.sh"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@lezer/highlight": "^1.2.1",
    "@uiw/react-codemirror": "^4.23.12",
    "lucide-react": "^0.511.0",
    "marked": "^14.1.4",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "playwright": "^1.52.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "yaml": "^2.8.0"
  }
}
